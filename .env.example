# GEMINI_API_KEY: Required for Gemini AI API calls.
# Injected at runtime or configured in Secrets panel.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""
APP_BASE_URL=""

# Payment Provider Configuration (e.g., Stripe, Tap Payments, Moyasar)
# In development, MockPaymentService is active if credentials are not provided.
PAYMENT_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# WhatsApp Cloud API Configuration
# In development, MockWhatsAppService simulates delivery with real status tracking.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_API_VERSION="v20.0"

# Storage & Database (In-Memory / SQLite / Cloud SQL / S3 compatible)
DATABASE_URL=""
STORAGE_BUCKET=""
ASSET_RETENTION_DAYS="7"

# Admin Authentication
ADMIN_SECRET_KEY="stickerme-admin-2025"

